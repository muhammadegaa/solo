# Create a client at https://admin.polaraccesslink.com with redirect URLs
#   http://localhost:3000/api/polar/callback (local)
#   https://usesolo.vercel.app/api/polar/callback (production)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:3000/api/polar/callback
# On Vercel: POLAR_REDIRECT_URI=https://usesolo.vercel.app/api/polar/callback
# Filled in after connecting once via /api/polar/connect
POLAR_ACCESS_TOKEN=
# Passcode for the app (the deployed URL can spend OpenRouter credit)
APP_PASSCODE=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
# OPENROUTER_TTS_VOICE=alloy
# Optional: ElevenLabs voice (replaces OpenRouter speech when the key is set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo
