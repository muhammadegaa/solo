# Create a client at https://admin.polaraccesslink.com with redirect URLs
#   http://localhost:3000/api/polar/callback (local)
#   https://usesolo.vercel.app/api/polar/callback (production)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:3000/api/polar/callback
# On Vercel: POLAR_REDIRECT_URI=https://usesolo.vercel.app/api/polar/callback
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5 (fastest tested: ~1.5-2s per reply)
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_TTS_MODEL=deepgram/aura-2
# OPENROUTER_TTS_VOICE=aura-2-thalia-en
# Optional: ElevenLabs voice (replaces OpenRouter speech when the key is set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo
# Firebase (project solo-11d30). Web config is public; the service account is secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# base64 of the service-account JSON (Admin SDK, server only)
FIREBASE_SERVICE_ACCOUNT_B64=
# Optional: session length in days (max 14)
# SESSION_DAYS=14
# Optional: dashboard settings
# APP_TIME_ZONE=Europe/London
# ACTIVE_DAY_STEPS=6000
# Optional: plan check and call memory
# PLAN_CHECK_MIN_STEPS=600
# PLAN_CHECK_BEFORE_MIN=30
# PLAN_CHECK_AFTER_MIN=90
# RECENT_CALL_DAYS=3
# Push notifications (generate VAPID keys with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://usesolo.vercel.app
# Shared secret for the scheduler that calls /api/cron/tick (also a GitHub Actions secret)
CRON_SECRET=
# Optional defaults for new users
# DEFAULT_MORNING_TIME=07:30
# DEFAULT_NUDGE_TIMES=11:00,15:00
# PUSH_LATE_MIN=60
# NUDGE_MOVED_STEPS=600
# Optional: findings
# FINDING_DAYS=28
# SHAPE_DAYS=14
# FIRST_MOVE_STEPS=300
# FINDING_REPEAT_DAYS=5
