# Create a client at https://admin.polaraccesslink.com with redirect URLs
#   http://localhost:3000/api/polar/callback (local)
#   https://usesolo.vercel.app/api/polar/callback (production)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:3000/api/polar/callback
# On Vercel: POLAR_REDIRECT_URI=https://usesolo.vercel.app/api/polar/callback
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5 (fastest tested: ~1.5-2s per reply)
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_TTS_MODEL=deepgram/aura-2
# OPENROUTER_TTS_VOICE=aura-2-thalia-en
# Optional: ElevenLabs voice (replaces OpenRouter speech when the key is set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo
# Firebase (project solo-11d30). Web config is public; the service account is secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# base64 of the service-account JSON (Admin SDK, server only)
FIREBASE_SERVICE_ACCOUNT_B64=
# Optional: session length in days (max 14)
# SESSION_DAYS=14
